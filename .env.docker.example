# Copy to .env.docker and fill in values before running the deployment Compose file.
# Do not commit .env.docker. These values are runtime configuration, not image build arguments.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
# Existing schema-generation behavior for first container startup. Review migrations before public deployment.
DB_DDL_AUTO=update
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded 32-byte random key; keep the same key when restarting or rebuilding.
INVITATION_TOKEN_ENCRYPTION_KEY=
AWS_REGION=ap-northeast-2
# Leave both blank when using a supported IAM role through the SDK credential provider chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
APP_PORT=8080
APP_IMAGE_TAG=local
DOCUMENT_CONVERSION_WORKER_ENABLED=true
S3_OBJECT_DELETION_WORKER_ENABLED=false
